#!/usr/bin/env bash
# Fast local gate: tests/run.sh covers syntax, lint (when shellcheck is installed) and tests.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

bash tests/run.sh >/dev/null || {
    echo "pre-commit: tests failed, run 'bash tests/run.sh' for details"
    exit 1
}
