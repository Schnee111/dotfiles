# ASUS Battery Care: default to 80% charge limit only on device add; members of asus-power may change it
SUBSYSTEM=="power_supply", KERNEL=="BAT0", ACTION=="add", ATTR{charge_control_end_threshold}="80"
SUBSYSTEM=="power_supply", KERNEL=="BAT0", RUN+="/bin/chgrp asus-power /sys/class/power_supply/BAT0/charge_control_end_threshold", RUN+="/bin/chmod 0664 /sys/class/power_supply/BAT0/charge_control_end_threshold"

# ASUS Platform Profile & Thermal Policy: writable by members of asus-power
SUBSYSTEM=="platform", KERNEL=="asus-nb-wmi", RUN+="/bin/chgrp asus-power /sys/firmware/acpi/platform_profile /sys/devices/platform/asus-nb-wmi/throttle_thermal_policy", RUN+="/bin/chmod 0664 /sys/firmware/acpi/platform_profile /sys/devices/platform/asus-nb-wmi/throttle_thermal_policy"
