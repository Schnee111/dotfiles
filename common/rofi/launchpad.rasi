/* App launcher (rofi/launcher.sh): the same frosted style as rice-switch.rasi,
 * as an icon grid. Neutral glass on purpose; translucent enough for the
 * compositor's blur and opaque enough to read without it. */

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "󰍉";
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec,categories,keywords";
    matching: "fuzzy";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    /* Arrows move between apps. Page_Up/Page_Down turn the page. The entry
     * keeps Ctrl+B / Ctrl+F for its cursor. */
    kb-row-left: "Left,Control+Page_Up";
    kb-row-right: "Right,Control+Page_Down";
    kb-move-char-back: "Control+b";
    kb-move-char-forward: "Control+f";
}

* {
    font: "Inter 10.5";

    glass: rgba(30, 30, 34, 66%);
    stroke: rgba(255, 255, 255, 14%);
    hairline: rgba(255, 255, 255, 7%);
    field: rgba(255, 255, 255, 8%);
    text: rgba(255, 255, 255, 92%);
    text-dim: rgba(235, 235, 245, 52%);
    hover: rgba(255, 255, 255, 10%);

    background-color: transparent;
    text-color: @text;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 900px;
    height: 620px;
    padding: 22px 18px 14px 18px;
    border: 1px;
    border-color: @stroke;
    border-radius: 26px;
    background-color: @glass;
}

mainbox {
    spacing: 14px;
    children: [ "inputbar", "listview", "textbox-footer" ];
}

inputbar {
    padding: 10px 16px;
    spacing: 12px;
    border-radius: 12px;
    background-color: @field;
    children: [ "prompt", "entry" ];
}

prompt {
    font: "JetBrainsMono Nerd Font 13";
    text-color: @text-dim;
    vertical-align: 0.5;
}

entry {
    font: "Inter Display 14";
    placeholder: "Search";
    placeholder-color: @text-dim;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    columns: 6;
    lines: 4;
    cycle: true;
    dynamic: true;
    scrollbar: true;
    scroll-method: 0;
    spacing: 6px;
    padding: 12px 0 0 0;
    border: 1px 0 0 0;
    border-color: @hairline;
}

element {
    orientation: vertical;
    padding: 16px 6px 12px 6px;
    spacing: 10px;
    border-radius: 16px;
    cursor: pointer;
}

element selected.normal,
element selected.active {
    background-color: @hover;
}

element-icon {
    size: 56px;
    horizontal-align: 0.5;
    cursor: pointer;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold;
    cursor: pointer;
}

textbox-footer {
    expand: false;
    str: "PgUp PgDn page   ·   ↵ open   ·   esc close";
    font: "Inter 9";
    text-color: @text-dim;
    horizontal-align: 0.5;
    padding: 10px 0 0 0;
    border: 1px 0 0 0;
    border-color: @hairline;
}

/* page indicator: the handle's position and length show which page of how many */
scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: rgba(255, 255, 255, 38%);
    border-radius: 2px;
    margin: 0 0 0 10px;
}
