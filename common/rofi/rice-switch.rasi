/* Rice switcher (bin/rice-switch): a frosted row list in the style of macOS.
 * Neutral glass on purpose; translucent enough for the compositor's blur and
 * opaque enough to read without it. */

configuration {
    show-icons: false;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    font: "Inter 10.5";

    glass: rgba(30, 30, 34, 66%);
    stroke: rgba(255, 255, 255, 14%);
    hairline: rgba(255, 255, 255, 7%);
    field: rgba(255, 255, 255, 8%);
    text: rgba(255, 255, 255, 92%);
    text-dim: rgba(235, 235, 245, 52%);
    hover: rgba(255, 255, 255, 10%);

    background-color: transparent;
    text-color: @text;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 540px;
    padding: 20px 14px 14px 14px;
    border: 1px;
    border-color: @stroke;
    border-radius: 24px;
    background-color: @glass;
}

mainbox {
    spacing: 12px;
    children: [ "header", "listview", "message" ];
}

header {
    orientation: horizontal;
    expand: false;
    spacing: 16px;
    padding: 0 6px;
    children: [ "textbox-title", "inputbar" ];
}

textbox-title {
    expand: true;
    content: "Switch Desktop";
    font: "Inter Display Semi-Bold 16";
    vertical-align: 0.5;
    horizontal-align: 0.0;
    text-color: @text;
}

inputbar {
    expand: false;
    width: 200px;
    padding: 7px 12px;
    spacing: 8px;
    border-radius: 10px;
    background-color: @field;
    children: [ "prompt", "entry" ];
}

prompt {
    font: "JetBrainsMono Nerd Font 11";
    text-color: @text-dim;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search";
    placeholder-color: @text-dim;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    columns: 1;
    dynamic: true;
    fixed-height: false;
    cycle: true;
    scrollbar: false;
    spacing: 2px;
    padding: 8px 0 0 0;
    border: 1px 0 0 0;
    border-color: @hairline;
}

element {
    padding: 9px 14px;
    border-radius: 12px;
    cursor: pointer;
}

element selected.normal,
element selected.active {
    background-color: @hover;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    highlight: bold;
    cursor: pointer;
}

message {
    padding: 10px 0 2px 0;
    border: 1px 0 0 0;
    border-color: @hairline;
}

/* the footer; textbox-title above sets its own colour and alignment */
textbox {
    font: "Inter 9";
    text-color: @text-dim;
    horizontal-align: 0.5;
}
