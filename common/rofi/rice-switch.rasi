/* Rice switcher (bin/rice-switch): a frosted grid of app-style tiles, after the
 * macOS Launchpad / Dock. Neutral glass on purpose: the tiles carry the colour. */

configuration {
    show-icons: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    /* the grid moves with the arrow keys; the entry keeps Ctrl+B / Ctrl+F */
    kb-row-left: "Left";
    kb-row-right: "Right";
    kb-move-char-back: "Control+b";
    kb-move-char-forward: "Control+f";
}

* {
    font: "Inter 10.5";

    glass: rgba(30, 30, 34, 66%);
    stroke: rgba(255, 255, 255, 14%);
    field: rgba(255, 255, 255, 8%);
    text: rgba(255, 255, 255, 92%);
    text-dim: rgba(235, 235, 245, 52%);
    tile: rgba(255, 255, 255, 11%);

    background-color: transparent;
    text-color: @text;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 664px;
    padding: 22px 22px 16px 22px;
    border: 1px;
    border-color: @stroke;
    border-radius: 26px;
    background-color: @glass;
}

mainbox {
    spacing: 18px;
    children: [ "header", "listview", "message" ];
}

header {
    orientation: horizontal;
    expand: false;
    spacing: 16px;
    children: [ "textbox-title", "inputbar" ];
}

textbox-title {
    expand: true;
    content: "Switch Desktop";
    font: "Inter Display Semi-Bold 16";
    vertical-align: 0.5;
}

inputbar {
    expand: false;
    width: 220px;
    padding: 7px 12px;
    spacing: 8px;
    border-radius: 10px;
    background-color: @field;
    children: [ "prompt", "entry" ];
}

prompt {
    font: "JetBrainsMono Nerd Font 11";
    text-color: @text-dim;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search";
    placeholder-color: @text-dim;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    columns: 4;
    lines: 2;
    fixed-columns: true;
    fixed-height: true;
    flow: horizontal;
    cycle: true;
    scrollbar: false;
    spacing: 8px;
}

element {
    orientation: vertical;
    padding: 14px 6px 10px 6px;
    spacing: 9px;
    border-radius: 16px;
    cursor: pointer;
}

element selected.normal,
element selected.active {
    background-color: @tile;
}

element-icon {
    size: 68px;
    horizontal-align: 0.5;
    cursor: pointer;
}

element-text {
    horizontal-align: 0.5;
    text-color: inherit;
    highlight: bold;
    cursor: pointer;
}

message {
    padding: 2px 0 0 0;
}

textbox {
    font: "Inter 9";
    text-color: @text-dim;
    horizontal-align: 0.5;
}
