#!/usr/bin/env bash
# ==============================================================================
# Desktop Rice & Compositor Switcher
# Seamlessly switch between desktop rices & compositors
# ==============================================================================
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CURRENT_RICE_FILE="$HOME/.config/.current_rice"

notify() {
    timeout 0.5 notify-send "Desktop Switcher" "$*" 2>/dev/null &
}

die() {
    notify "$*"
    echo "rice-switch: $*" >&2
    exit 1
}

current_rice() {
    if [ -f "$CURRENT_RICE_FILE" ]; then
        cat "$CURRENT_RICE_FILE" | tr -d '[:space:]'
    elif pgrep -x Hyprland >/dev/null 2>&1; then
        echo "end4"
    elif pgrep -x niri >/dev/null 2>&1; then
        echo "iris"
    else
        echo "unknown"
    fi
}

exit_compositor() {
    if pgrep -x Hyprland >/dev/null 2>&1; then
        hyprctl dispatch 'hl.dsp.exit()' 2>/dev/null || pkill -x Hyprland || loginctl terminate-session "${XDG_SESSION_ID:-}"
    elif pgrep -x niri >/dev/null 2>&1; then
        niri msg action quit --skip-confirmation 2>/dev/null || pkill -x niri || loginctl terminate-session "${XDG_SESSION_ID:-}"
    elif pgrep -x umbriel >/dev/null 2>&1; then
        umbriel msg session-quit 2>/dev/null || pkill -x umbriel || loginctl terminate-session "${XDG_SESSION_ID:-}"
    else
        loginctl terminate-session "${XDG_SESSION_ID:-}" 2>/dev/null || gnome-session-quit --logout --no-prompt 2>/dev/null || true
    fi
}

gui_menu() {
    local current
    current="$(current_rice)"

    local options=()
    local rice_names=()

    for d in "$DOTFILES_DIR"/rices/*/; do
        if [[ -d "$d" ]]; then
            local rname="$(basename "$d")"
            local dname="$rname"
            local conf_file="$d/rice.conf"

            if [[ -f "$conf_file" ]]; then
                # Source metadata in subshell
                dname="$(bash -c "source '$conf_file' 2>/dev/null && echo \"\${DISPLAY_NAME:-\$rname}\"")"
            fi

            if [[ "$rname" == "$current" ]]; then
                dname="✓  $dname   [ACTIVE]"
            fi

            options+=("$dname")
            rice_names+=("$rname")
        fi
    done

    if [[ ${#options[@]} -eq 0 ]]; then
        die "No rices found in $DOTFILES_DIR/rices/"
    fi

    local menu_input=""
    for opt in "${options[@]}"; do
        menu_input+="$opt"$'\n'
    done

    local choice=""
    if command -v rofi >/dev/null 2>&1 && [[ -f "$HOME/.config/rofi/display.rasi" ]]; then
        choice=$(printf "%s" "$menu_input" | rofi -dmenu -i -p "󰍹 Switch Rice" -theme "$HOME/.config/rofi/display.rasi") || exit 0
    elif command -v fuzzel >/dev/null 2>&1; then
        choice=$(printf "%s" "$menu_input" | fuzzel --dmenu --prompt "Switch Rice ❯ " --lines "${#options[@]}") || exit 0
    else
        die "Neither rofi nor fuzzel is installed"
    fi

    # Match choice back to rice name
    for i in "${!options[@]}"; do
        if [[ "${options[$i]}" == "$choice" ]]; then
            echo "${rice_names[$i]}"
            return 0
        fi
    done

    exit 0
}

switch_to() {
    local target="$1"
    local current
    current="$(current_rice)"

    if [ "$target" = "status" ]; then
        echo "Active compositor process: $(pgrep -x Hyprland >/dev/null && echo Hyprland || (pgrep -x niri >/dev/null && echo niri || (pgrep -x umbriel >/dev/null && echo umbriel || echo none)))"
        echo "Active rice profile: $(current_rice)"
        echo "Configured GDM session: $(busctl get-property org.freedesktop.Accounts "/org/freedesktop/Accounts/User$UID" org.freedesktop.Accounts.User Session 2>/dev/null || echo unknown)"
        return 0
    fi

    if [ "$target" = "list" ]; then
        echo "Available rices in $DOTFILES_DIR/rices/:"
        for d in "$DOTFILES_DIR"/rices/*/; do
            if [[ -d "$d" ]]; then
                local rname="$(basename "$d")"
                local dname="$rname"
                local conf_file="$d/rice.conf"
                if [[ -f "$conf_file" ]]; then
                    dname="$(bash -c "source '$conf_file' 2>/dev/null && echo \"\${DISPLAY_NAME:-\$rname}\"")"
                fi
                if [[ "$rname" == "$current" ]]; then
                    echo "  * $dname   [ACTIVE]"
                else
                    echo "    $dname"
                fi
            fi
        done
        return 0
    fi

    local target_dir="$DOTFILES_DIR/rices/$target"
    if [[ ! -d "$target_dir" ]]; then
        die "Rice '$target' not found in $DOTFILES_DIR/rices/"
    fi

    if [ "$target" = "$current" ]; then
        notify "Profile '$target' is already active."
        exit 0
    fi

    # Read target compositor & session
    local compositor="hyprland"
    local session="hyprland"
    local conf_file="$target_dir/rice.conf"
    if [[ -f "$conf_file" ]]; then
        compositor="$(bash -c "source '$conf_file' 2>/dev/null && echo \"\${COMPOSITOR:-hyprland}\"")"
        session="$(bash -c "source '$conf_file' 2>/dev/null && echo \"\${SESSION:-\$compositor}\"")"
    elif [[ -d "$target_dir/niri" ]]; then
        compositor="niri"
        session="niri"
    fi

    # Check if target compositor is installed
    if ! command -v "$compositor" >/dev/null 2>&1; then
        die "Compositor '$compositor' is not installed."
    fi

    # Check if session desktop file exists for GDM / display manager
    if [[ ! -f "/usr/share/wayland-sessions/${session}.desktop" && ! -f "/usr/local/share/wayland-sessions/${session}.desktop" ]]; then
        die "Wayland session '${session}.desktop' not found in /usr/share/wayland-sessions/."
    fi

    notify "Switching to '$target' ($compositor)... Logging out"

    # Link new rice configs
    "$DOTFILES_DIR/install.sh" --rice "$target" || die "install.sh failed for '$target'. Configs unchanged, staying on '$current'."

    # Validate the target compositor config before committing the switch.
    # On failure the switch aborts here: GDM session and .current_rice are
    # left untouched, so the user stays on the working rice.
    case "$compositor" in
        hyprland)
            if ! timeout 60 hyprland --verify-config >/dev/null 2>&1; then
                die "hyprland --verify-config failed after linking '$target'. Staying on '$current'."
            fi
            ;;
        niri)
            if ! timeout 60 niri validate >/dev/null 2>&1; then
                die "niri validate failed after linking '$target'. Staying on '$current'."
            fi
            ;;
        umbriel)
            if ! timeout 60 umbriel config validate -c "$HOME/.config/umbriel/config.toml" >/dev/null 2>&1; then
                die "umbriel config validate failed after linking '$target'. Staying on '$current'."
            fi
            ;;
    esac

    # Configure GDM session
    busctl call org.freedesktop.Accounts "/org/freedesktop/Accounts/User$UID" org.freedesktop.Accounts.User SetSession s "$session" 2>/dev/null || true
    busctl call org.freedesktop.Accounts "/org/freedesktop/Accounts/User$UID" org.freedesktop.Accounts.User SetSessionType s "wayland" 2>/dev/null || true

    echo "$target" > "$CURRENT_RICE_FILE"
    sleep 0.5
    exit_compositor
}

ACTION="${1:-}"
if [ -z "$ACTION" ]; then
    ACTION="$(gui_menu)"
fi

switch_to "$ACTION"
