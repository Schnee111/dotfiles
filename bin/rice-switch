#!/usr/bin/env bash
# ==============================================================================
# Desktop Rice & Compositor Switcher
# Seamlessly switch between desktop rices & compositors
#
# Order of operations matters: link -> verify -> commit session/state -> logout.
# If verification fails the install snapshot is rolled back, so a broken rice
# can never leave ~/.config pointing at config that cannot start.
# ==============================================================================
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CURRENT_RICE_FILE="$HOME/.config/.current_rice"
DRY_RUN=0

notify() {
    timeout 0.5 notify-send "Desktop Switcher" "$*" 2>/dev/null &
}

die() {
    notify "$*"
    echo "rice-switch: $*" >&2
    exit 1
}

current_rice() {
    if [ -f "$CURRENT_RICE_FILE" ]; then
        tr -d '[:space:]' <"$CURRENT_RICE_FILE"
    elif pgrep -x Hyprland >/dev/null 2>&1; then
        echo "end4"
    elif pgrep -x niri >/dev/null 2>&1; then
        echo "iris"
    else
        echo "unknown"
    fi
}

# Read one KEY="value" from a rice.conf without executing it. The file is data,
# not a script: sourcing it three times per menu render was both slower and an
# unnecessary code-execution path.
rice_meta() {
    local file="$1" key="$2" line
    [[ -f "$file" ]] || return 0
    line="$(grep -m1 -E "^[[:space:]]*${key}=" "$file" || true)"
    [[ -n "$line" ]] || return 0
    line="${line#*=}"
    line="${line#\"}"
    line="${line%\"}"
    printf '%s' "$line"
}

rice_title() {
    local name
    name="$(rice_meta "$1/rice.conf" DISPLAY_NAME)"
    printf '%s' "${name:-$(basename "$1")}"
}

# "Hyprland · end4-pC Material 3", from COMPOSITOR and SHELL_NAME
rice_subtitle() {
    local compositor shell
    compositor="$(rice_meta "$1/rice.conf" COMPOSITOR)"
    shell="$(rice_meta "$1/rice.conf" SHELL_NAME)"
    compositor="${compositor^}"
    if [[ -n "$compositor" && -n "$shell" ]]; then
        printf '%s · %s' "$compositor" "$shell"
    else
        printf '%s' "$compositor$shell"
    fi
}

exit_compositor() {
    if pgrep -x Hyprland >/dev/null 2>&1; then
        hyprctl dispatch exit 2>/dev/null || pkill -x Hyprland || loginctl terminate-session "${XDG_SESSION_ID:-}"
    elif pgrep -x niri >/dev/null 2>&1; then
        niri msg action quit --skip-confirmation 2>/dev/null || pkill -x niri || loginctl terminate-session "${XDG_SESSION_ID:-}"
    elif pgrep -x umbriel >/dev/null 2>&1; then
        umbriel msg "session-quit:skip-confirmation" 2>/dev/null || pkill -x umbriel || loginctl terminate-session "${XDG_SESSION_ID:-}"
    else
        loginctl terminate-session "${XDG_SESSION_ID:-}" 2>/dev/null || gnome-session-quit --logout --no-prompt 2>/dev/null || true
    fi
}

markup_escape() {
    local s="${1//&/&amp;}"
    s="${s//</&lt;}"
    printf '%s' "${s//>/&gt;}"
}

# Prints the chosen rice name, or nothing when the menu is cancelled. Both menus
# return the row index (-format i / --index), so the shown text can be anything.
gui_menu() {
    local current
    current="$(current_rice)"

    local rice_names=() plain_rows="" rofi_rows="" active=""
    local gutter_on='<span font="JetBrainsMono Nerd Font 8" alpha="80%">●  </span>'
    # alpha 1%: Pango's alpha range starts at 1, so 0% is not a valid value
    local gutter_off='<span font="JetBrainsMono Nerd Font 8" alpha="1%">●  </span>'
    for d in "$DOTFILES_DIR"/rices/*/; do
        [[ -d "$d" ]] || continue
        local rname title subtitle
        rname="$(basename "$d")"
        title="$(rice_title "$d")"
        subtitle="$(rice_subtitle "$d")"

        [[ "$rname" == "$current" ]] && active="${#rice_names[@]}"
        rice_names+=("$rname")
        plain_rows+="$title${subtitle:+ — $subtitle}"$'\n'
        # A leading column holds a dot for the current rice. Both lines start
        # with the same monospace glyph (invisible where unused), so the name
        # and the subtitle stay aligned whatever the proportional font does.
        local dot="$gutter_off"
        [[ "$rname" == "$current" ]] && dot="$gutter_on"
        rofi_rows+="$dot<span weight=\"600\">$(markup_escape "$title")</span>"
        [[ -n "$subtitle" ]] && rofi_rows+=$'\n'"$gutter_off<span size=\"small\" alpha=\"55%\">$(markup_escape "$subtitle")</span>"
        rofi_rows+=$'\x1f'
    done

    if [[ ${#rice_names[@]} -eq 0 ]]; then
        die "No rices found in $DOTFILES_DIR/rices/"
    fi

    local choice="" theme=""
    for theme in "$HOME/.config/rofi/rice-switch.rasi" "$HOME/.config/rofi/display.rasi" ""; do
        [[ -z "$theme" || -f "$theme" ]] && break
    done
    if command -v rofi >/dev/null 2>&1 && [[ -n "$theme" ]]; then
        # Rows are two lines (name, then compositor · shell), so they are
        # separated by \x1f instead of newlines
        local args=(-dmenu -i -no-custom -format i -markup-rows -sep $'\x1f' -eh 2
            -l "${#rice_names[@]}" -p "󰍉" -theme "$theme"
            -mesg "Switching logs you out   ·   ↵ switch   ·   esc cancel")
        [[ -n "$active" ]] && args+=(-a "$active" -selected-row "$active")
        choice=$(printf '%s' "$rofi_rows" | rofi "${args[@]}") || return 0
    elif command -v fuzzel >/dev/null 2>&1; then
        choice=$(printf '%s' "$plain_rows" | fuzzel --dmenu --index --prompt "Switch rice ❯ " --lines "${#rice_names[@]}") || return 0
    else
        die "Neither rofi nor fuzzel is installed"
    fi

    if [[ "$choice" =~ ^[0-9]+$ && -n "${rice_names[$choice]:-}" ]]; then
        echo "${rice_names[$choice]}"
    fi
}

verify_config() {
    local compositor="${1,,}" bin=""
    # Fedora ships both /usr/bin/hyprland and /usr/bin/Hyprland, but do not assume
    # the binary matches the rice.conf spelling: try the lower-case name first,
    # then the capitalised one, and report a missing binary as such instead of
    # letting it masquerade as a config failure.
    bin="$(command -v "$compositor" 2>/dev/null || command -v "${compositor^}" 2>/dev/null || true)"
    if [[ -z "$bin" ]]; then
        echo "rice-switch: cannot verify, no '$compositor' binary in PATH; skipping" >&2
        return 0
    fi
    case "$compositor" in
        hyprland) timeout 60 "$bin" --verify-config >/dev/null 2>&1 ;;
        niri) timeout 60 "$bin" validate >/dev/null 2>&1 ;;
        umbriel) timeout 60 "$bin" config validate -c "$HOME/.config/umbriel/config.toml" >/dev/null 2>&1 ;;
        *) return 0 ;;
    esac
}

switch_to() {
    local target="$1"
    local current
    current="$(current_rice)"

    if [ "$target" = "status" ]; then
        echo "Active compositor process: $(pgrep -x Hyprland >/dev/null && echo Hyprland || (pgrep -x niri >/dev/null && echo niri || (pgrep -x umbriel >/dev/null && echo umbriel || echo none)))"
        echo "Active rice profile: $(current_rice)"
        local session
        session="$(busctl get-property org.freedesktop.Accounts "/org/freedesktop/Accounts/User$UID" org.freedesktop.Accounts.User Session 2>/dev/null | sed -e 's/^s //' -e 's/^"//' -e 's/"$//' || true)"
        echo "Configured GDM session: ${session:-unknown}"
        if command -v dotfiles >/dev/null 2>&1; then
            echo "Verify symlink map: dotfiles doctor"
        fi
        return 0
    fi

    if [ "$target" = "list" ]; then
        echo "Available rices in $DOTFILES_DIR/rices/:"
        for d in "$DOTFILES_DIR"/rices/*/; do
            if [[ -d "$d" ]]; then
                local rname mark="   "
                rname="$(basename "$d")"
                [[ "$rname" == "$current" ]] && mark="  *"
                # the directory name is what `rice-switch <name>` takes
                printf '%s %-13s %s\n' "$mark" "$rname" "$(rice_subtitle "$d")"
            fi
        done
        return 0
    fi

    # An empty name would resolve to rices/ itself and pass the check below
    if [[ ! "$target" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        die "Invalid rice name '$target'"
    fi
    local target_dir="$DOTFILES_DIR/rices/$target"
    if [[ ! -d "$target_dir" ]]; then
        die "Rice '$target' not found in $DOTFILES_DIR/rices/"
    fi

    if [ "$target" = "$current" ]; then
        notify "Profile '$target' is already active."
        exit 0
    fi

    # Read target compositor & session
    local compositor="hyprland"
    local session="hyprland"
    local conf_file="$target_dir/rice.conf"
    if [[ -f "$conf_file" ]]; then
        compositor="$(rice_meta "$conf_file" COMPOSITOR)"
        compositor="${compositor:-hyprland}"
        session="$(rice_meta "$conf_file" SESSION)"
        session="${session:-$compositor}"
    elif [[ -d "$target_dir/niri" ]]; then
        compositor="niri"
        session="niri"
    fi

    # Check if target compositor is installed
    if ! command -v "$compositor" >/dev/null 2>&1; then
        die "Compositor '$compositor' is not installed."
    fi

    # Check if session desktop file exists for GDM / display manager
    if [[ ! -f "/usr/share/wayland-sessions/${session}.desktop" && ! -f "/usr/local/share/wayland-sessions/${session}.desktop" ]]; then
        die "Wayland session '${session}.desktop' not found in /usr/share/wayland-sessions/."
    fi

    if [[ $DRY_RUN -eq 1 ]]; then
        echo "rice-switch: dry run for '$target' (compositor: $compositor, session: $session)"
        "$DOTFILES_DIR/install.sh" --dry-run --rice "$target" --no-set-current
        echo "rice-switch: dry run only — would verify '$compositor' config, set GDM session '$session', then log out."
        exit 0
    fi

    notify "Switching to '$target' ($compositor)... Logging out"

    # 1. Link new rice configs. --no-set-current keeps the active-rice marker
    #    untouched until verification passes, so a failed switch never claims a
    #    rice it just rolled back.
    if ! "$DOTFILES_DIR/install.sh" --rice "$target" --no-set-current; then
        die "install.sh failed for '$target'. Configs unchanged, staying on '$current'."
    fi

    # 2. Validate the target compositor config before committing the switch.
    #    On failure restore the pre-install symlink map; the installer recorded
    #    every touched path, so "staying on current" is now literal.
    if ! verify_config "$compositor"; then
        notify "'$target' config failed verification — rolled back to '$current'"
        echo "rice-switch: verification failed for '$target'; restoring previous config." >&2
        "$DOTFILES_DIR/install.sh" --rollback || echo "rice-switch: rollback failed, inspect $HOME/.local/state/dotfiles" >&2
        exit 1
    fi

    # 3. Commit: GDM session + active-rice marker.
    busctl call org.freedesktop.Accounts "/org/freedesktop/Accounts/User$UID" org.freedesktop.Accounts.User SetSession s "$session" 2>/dev/null || true
    busctl call org.freedesktop.Accounts "/org/freedesktop/Accounts/User$UID" org.freedesktop.Accounts.User SetSessionType s "wayland" 2>/dev/null || true

    echo "$target" >"$CURRENT_RICE_FILE"
    sleep 0.5
    exit_compositor
}

ACTION=""
for arg in "$@"; do
    case "$arg" in
        -n | --dry-run) DRY_RUN=1 ;;
        *)
            if [[ -z "$ACTION" ]]; then
                ACTION="$arg"
            else
                die "Unexpected argument: $arg"
            fi
            ;;
    esac
done

if [ -z "$ACTION" ]; then
    ACTION="$(gui_menu)"
    # Empty when the menu was cancelled (Esc): nothing was chosen, so stop here.
    [[ -n "$ACTION" ]] || exit 0
fi

switch_to "$ACTION"
