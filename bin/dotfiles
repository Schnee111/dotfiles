#!/usr/bin/env bash
# ==============================================================================
# dotfiles — one entry point for the rice stack
#
#   dotfiles switch [rice]     rice-switch (relink + verify + session + logout)
#   dotfiles install [rice]    install.sh (relink only, no logout)
#   dotfiles status            active rice, session, manifest size
#   dotfiles doctor [--fix]    verify the symlink map against the manifest
#   dotfiles diff              uncommitted config vs generated state
#   dotfiles save -m "msg"     commit only generated/state files
#   dotfiles rollback          restore the last install snapshot
# ==============================================================================
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
MANIFEST="$STATE_DIR/manifest.tsv"
CURRENT_RICE_FILE="$CONFIG_DIR/.current_rice"

# Files the apps write themselves (Matugen palette, end-4 shell state). Kept in
# the repo on purpose — they hold the theme/UI you tuned — but committed apart
# from hand-written config so `git diff` stays readable.
STATE_GLOBS=(
    "rices/*/illogical-impulse/config.json"
    "rices/*/hypr/hyprland/colors.lua"
)

c_red=$'\033[1;31m'; c_grn=$'\033[1;32m'; c_ylw=$'\033[1;33m'
c_blu=$'\033[1;34m'; c_dim=$'\033[2m'; c_rst=$'\033[0m'

say() { printf '%s%s%s\n' "$c_blu" "$*" "$c_rst"; }
ok() { printf '%s  ok  %s %s\n' "$c_grn" "$c_rst" "$*"; }
warn() { printf '%s warn %s %s\n' "$c_ylw" "$c_rst" "$*"; }
bad() { printf '%s fail %s %s\n' "$c_red" "$c_rst" "$*"; }

# Count glob matches without a pipeline: `ls ... | wc -l` under `set -o
# pipefail` returns ls's exit status (2 = "no matches"), which aborts the script
# when the result is assigned.
count_glob() {
    local pattern="$1" n=0
    shopt -s nullglob
    # The pattern must expand HERE, not at the call site: an unquoted glob at the
    # call site arrives as N positional args and only $1 was counted (a machine
    # with 8 backups reported 1).
    # shellcheck disable=SC2086
    set -- $pattern
    n=$#
    shopt -u nullglob
    printf '%s' "$n"
}

current_rice() {
    if [[ -f "$CURRENT_RICE_FILE" ]]; then
        tr -d '[:space:]' <"$CURRENT_RICE_FILE"
    else
        echo "unknown"
    fi
}

running_compositor() {
    if pgrep -x Hyprland >/dev/null 2>&1; then echo Hyprland
    elif pgrep -x niri >/dev/null 2>&1; then echo niri
    elif pgrep -x umbriel >/dev/null 2>&1; then echo umbriel
    else echo none; fi
}

gdm_session() {
    busctl get-property org.freedesktop.Accounts "/org/freedesktop/Accounts/User$UID" \
        org.freedesktop.Accounts.User Session 2>/dev/null | sed -e 's/^s //' -e 's/^"//' -e 's/"$//' || true
}

rice_meta() {
    local file="$DOTFILES_DIR/rices/$1/rice.conf" key="$2" line
    [[ -f "$file" ]] || return 0
    line="$(grep -m1 -E "^[[:space:]]*${key}=" "$file" || true)"
    [[ -n "$line" ]] || return 0
    line="${line#*=}"
    line="${line#\"}"
    line="${line%\"}"
    printf '%s' "$line"
}

cmd_status() {
    local rice; rice="$(current_rice)"
    say "Active rice:   ${rice}"
    say "Compositor:    $(running_compositor) (rice wants: $(rice_meta "$rice" COMPOSITOR))"
    say "GDM session:   $(gdm_session)"
    say "Config dir:    $CONFIG_DIR"
    if [[ -f "$MANIFEST" ]]; then
        say "Manifest:      $(wc -l <"$MANIFEST") managed paths ($MANIFEST)"
    else
        warn "No manifest yet — run 'dotfiles install' so doctor has a baseline"
    fi
    local snaps backups
    snaps="$(count_glob "$STATE_DIR/rollback-*.tsv")"
    local last_snap=""
    last_snap="$(ls -1dt "$STATE_DIR"/rollback-*.tsv 2>/dev/null | head -n1 || true)"
    if [[ -n "$last_snap" ]]; then
        last_snap="$(basename "$last_snap")"
    else
        last_snap="none"
    fi
    say "Snapshots:     $snaps (last: $last_snap)"
    backups="$(count_glob "$CONFIG_DIR/dotfiles_backup_*")"
    say "Backups:       $backups"
}

# ------------------------------------------------------------------------------
# doctor: compare what the installer claims to own (manifest) with what is
# actually on disk. This is the only thing that catches a shell rewriting a
# symlink into a regular file via atomic rename — the config then silently stops
# tracking the repo.
# ------------------------------------------------------------------------------
doctor() {
    local fix=0 issues=0
    [[ "${1:-}" == "--fix" ]] && fix=1

    if [[ ! -f "$MANIFEST" ]]; then
        bad "No manifest at $MANIFEST — cannot verify ownership. Run: dotfiles install"
        return 1
    fi

    local dest src kind
    local -a drifted=()
    local notes=0
    while IFS=$'\t' read -r dest src; do
        [[ -n "$dest" ]] || continue
        if [[ -L "$dest" ]]; then
            local resolved want_resolved
            resolved="$(readlink -f "$dest" 2>/dev/null || true)"
            want_resolved="$(readlink -f "$src" 2>/dev/null || true)"
            if [[ -n "$resolved" && "$resolved" == "$want_resolved" ]]; then
                continue
            elif [[ -z "$resolved" ]]; then
                bad "dangling   $dest -> $(readlink "$dest")"
                issues=$((issues + 1))
            else
                bad "drift      $dest -> $resolved (expected $want_resolved)"
                issues=$((issues + 1))
            fi
        elif [[ -e "$dest" ]]; then
            kind="file"; [[ -d "$dest" ]] && kind="dir"
            bad "replaced   $dest is a real $kind, not a symlink to $src"
            drifted+=("$dest")
            issues=$((issues + 1))
        else
            bad "missing    $dest (should link to $src)"
            drifted+=("$dest")
            issues=$((issues + 1))
        fi
    done <"$MANIFEST"

    # Foreign links inside the *active compositor's* tree: a path that points
    # into another rice's tree can shadow the active rice's modules. Outside
    # that tree (niri/, umbriel/, noctalia/, inir/ while Hyprland runs) another
    # rice's config is inert, so it is reported as a note, not a failure.
    local rice foreign=0 link target
    rice="$(current_rice)"
    while IFS= read -r link; do
        target="$(readlink -f "$link" 2>/dev/null || true)"
        [[ "$target" == "$DOTFILES_DIR/rices/"* ]] || continue
        case "$target" in
            "$DOTFILES_DIR/rices/$rice/"*) ;;
            *)
                warn "leftover   $link -> ${target#"$DOTFILES_DIR"/} (not loaded by '$rice')"
                foreign=$((foreign + 1))
                notes=$((notes + 1))
                ;;
        esac
    done < <(find "$CONFIG_DIR/hypr" "$CONFIG_DIR/quickshell" -maxdepth 4 -type l 2>/dev/null)

    # Session consistency: the greeter launches what AccountsService says.
    local want got
    want="$(rice_meta "$rice" SESSION)"
    got="$(gdm_session)"
    if [[ -n "$want" && -n "$got" && "$want" != "$got" ]]; then
        warn "GDM session is '$got' but rice '$rice' needs '$want' (gear menu at login, or rice-switch)"
        issues=$((issues + 1))
    fi

    local backups
    backups="$(count_glob "$CONFIG_DIR/dotfiles_backup_*")"
    (( backups > 5 )) && warn "$backups backup trees in $CONFIG_DIR (installer prunes to 5 on the next run)"

    if (( issues == 0 )); then
        ok "all managed paths match the manifest"
        (( notes > 0 )) && warn "$notes leftover link(s) from other rices (harmless unless the active rice loads them)"
        return 0
    fi

    printf '\n%s%d issue(s)%s — %d path(s) need relinking\n' "$c_ylw" "$issues" "$c_rst" "${#drifted[@]}"
    if (( fix == 1 )); then
        say "Relinking rice '$rice'..."
        "$DOTFILES_DIR/install.sh" --rice "$rice"
        say "Re-checking..."
        doctor
    else
        printf '%sfix with:%s dotfiles doctor --fix   (or: dotfiles install %s)\n' "$c_dim" "$c_rst" "$rice"
        return 1
    fi
}

cmd_diff() {
    say "Repo changes (hand-written config):"
    git -C "$DOTFILES_DIR" status --short -- . ':(exclude)rices/*/illogical-impulse/config.json' \
        ':(exclude)rices/*/hypr/hyprland/colors.lua' || true
    say "Generated/state changes:"
    git -C "$DOTFILES_DIR" status --short -- "${STATE_GLOBS[@]}" || true
    say "Symlink drift:"
    if [[ ! -f "$MANIFEST" ]]; then
        warn "no manifest yet (run: dotfiles install)"
        return 0
    fi
    local dest src drift=0
    while IFS=$'\t' read -r dest src; do
        [[ -n "$dest" ]] || continue
        if [[ -L "$dest" ]]; then
            local got want
            got="$(readlink -f "$dest" 2>/dev/null || true)"
            want="$(readlink -f "$src" 2>/dev/null || true)"
            [[ -n "$got" && "$got" == "$want" ]] && continue
        fi
        printf '  %s\n' "$dest"
        drift=$((drift + 1))
    done <"$MANIFEST"
    (( drift == 0 )) && ok "none"
}

cmd_save() {
    local msg=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m | --message)
                [[ $# -ge 2 ]] || {
                    bad "-m needs a message"
                    return 1
                }
                msg="$2"
                shift 2
                ;;
            *)
                msg="$1"
                shift
                ;;
        esac
    done
    [[ -n "$msg" ]] || msg="sync generated theme/UI state"

    # 'save' commits the whole index, so refuse when someone else's staged work
    # is already there instead of silently folding it into chore(state).
    if ! git -C "$DOTFILES_DIR" diff --cached --quiet; then
        bad "index already has staged changes; commit or unstage them first"
        return 1
    fi

    local staged=0
    for glob in "${STATE_GLOBS[@]}"; do
        while IFS= read -r f; do
            [[ -n "$f" ]] || continue
            git -C "$DOTFILES_DIR" add -- "$f"
            staged=1
        done < <(git -C "$DOTFILES_DIR" ls-files -m -o --exclude-standard -- "$glob")
    done

    if [[ $staged -eq 0 ]]; then
        ok "no generated/state changes to save"
        return 0
    fi
    if git -C "$DOTFILES_DIR" diff --cached --quiet; then
        ok "nothing staged"
        return 0
    fi
    git -C "$DOTFILES_DIR" commit -m "chore(state): $msg"
    ok "saved generated state"
}

usage() {
    sed -n '/^#   dotfiles switch/,/^#   dotfiles rollback/p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-status}" in
    switch) shift; exec "$DOTFILES_DIR/bin/rice-switch" "$@" ;;
    install) shift; exec "$DOTFILES_DIR/install.sh" "$@" ;;
    status) cmd_status ;;
    doctor) shift; doctor "${1:-}" ;;
    diff) cmd_diff ;;
    save) shift; cmd_save "$@" ;;
    rollback) exec "$DOTFILES_DIR/install.sh" --rollback ;;
    -h | --help | help) usage ;;
    *)
        echo "Unknown command: $1" >&2
        usage
        exit 1
        ;;
esac