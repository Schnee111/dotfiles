#!/usr/bin/env bash
#
# vitreus-brightness — brightness control that follows the active monitor.
#
# * External monitor, laptop panel off (HDMI/DP connected, eDP inactive)
#   → DDC/CI via ddcutil (VCP 10 brightness).
# * Laptop panel active → brightnessctl (intel_backlight), as before.
#
# Prints the new level as a 0..1 fraction on stdout, for the shell OSD:
#   pleamar --say vitreus "emit bright_key $(vitreus-brightness up)"
#
# Usage: vitreus-brightness up|down|get|set <0..1>

set -euo pipefail

STEP_PCT=5

# Print the I2C bus number of the first connected external monitor, if any.
find_ddc_bus() {
    local st link
    for st in /sys/class/drm/card*-HDMI-A-*/status /sys/class/drm/card*-DP-*/status; do
        [[ -r "$st" ]] || continue
        [[ "$(cat "$st" 2>/dev/null)" == "connected" ]] || continue
        link=$(readlink "${st%/status}/ddc" 2>/dev/null || true)
        if [[ "$link" =~ i2c-([0-9]+) ]]; then
            printf '%s' "${BASH_REMATCH[1]}"
            return 0
        fi
    done
    return 1
}

# Is the laptop panel currently an active Hyprland monitor?
edp_active() {
    hyprctl monitors 2>/dev/null | grep -q '^Monitor eDP-1'
}

# $1 = raw value, $2 = max → 0..1 fraction with 4 decimals.
frac() {
    awk -v v="$1" -v m="$2" 'BEGIN { if (m <= 0) m = 100; printf "%.4f", v / m }'
}

# Echoes "current max" of the DDC monitor, or nothing on failure.
ddc_get() {
    ddcutil -b "$BUS" getvcp 10 --brief 2>/dev/null | awk '{ print $4, $5 }'
}

# Reads ddc_get into CUR/MAX globals; returns non-zero when unusable.
ddc_read() {
    CUR=""; MAX=""
    read -r CUR MAX <<<"$(ddc_get)"
    [[ "$CUR" =~ ^[0-9]+$ && "$MAX" =~ ^[0-9]+$ && "$MAX" -gt 0 ]]
}

# $1 = raw value, $2 = max. Clamps, sets, prints the new fraction.
ddc_set() {
    local raw=$1 max=$2
    if ((raw < 1)); then raw=1; fi
    if ((raw > max)); then raw=$max; fi
    ddcutil -b "$BUS" setvcp 10 "$raw" --noverify >/dev/null 2>&1
    frac "$raw" "$max"
}

backlight_up() {
    brightnessctl -e4 -n2 -m set "${STEP_PCT}%+" | awk -F, '{ printf "%.4f", $3/$5 }'
}

backlight_down() {
    brightnessctl -e4 -n2 -m set "${STEP_PCT}%-" | awk -F, '{ printf "%.4f", $3/$5 }'
}

backlight_get() {
    brightnessctl -m | awk -F, '{ printf "%.4f", $3/$5 }'
}

# $1 = 0..1 fraction.
backlight_set() {
    local pct
    pct=$(awk -v v="$1" 'BEGIN { p = int(v * 100); if (p < 1) p = 1; if (p > 100) p = 100; print p }')
    brightnessctl -e4 -n2 -m set "${pct}%" | awk -F, '{ printf "%.4f", $3/$5 }'
}

BUS=""
use_ddc=false
if BUS=$(find_ddc_bus 2>/dev/null) && ! edp_active; then
    if command -v ddcutil >/dev/null 2>&1; then
        use_ddc=true
    fi
fi

cmd="${1:-get}"
case "$cmd" in
    up)
        if [[ "$use_ddc" == true ]] && ddc_read; then
            step=$(((MAX * STEP_PCT + 50) / 100))
            if ((step < 1)); then step=1; fi
            ddc_set $((CUR + step)) "$MAX"
        else
            backlight_up
        fi
        ;;
    down)
        if [[ "$use_ddc" == true ]] && ddc_read; then
            step=$(((MAX * STEP_PCT + 50) / 100))
            if ((step < 1)); then step=1; fi
            ddc_set $((CUR - step)) "$MAX"
        else
            backlight_down
        fi
        ;;
    set)
        val="${2:?usage: vitreus-brightness set <0..1>}"
        if [[ "$use_ddc" == true ]] && ddc_read; then
            raw=$(awk -v v="$val" -v m="$MAX" 'BEGIN { r = int(v * m); if (r < 1) r = 1; if (r > m) r = m; print r }')
            ddc_set "$raw" "$MAX"
        else
            backlight_set "$val"
        fi
        ;;
    get | *)
        if [[ "$use_ddc" == true ]] && ddc_read; then
            frac "$CUR" "$MAX"
        else
            backlight_get
        fi
        ;;
esac
