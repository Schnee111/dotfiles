@import "colors.rasi"

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec,categories,keywords";
    matching: "fuzzy";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    font: "Google Sans Flex 11";
}

window {
    transparency: "real";
    background-color: @bg;
    text-color: @fg;
    border: 2px;
    border-color: @border-col;
    border-radius: 24px;
    width: 960px;
    height: 640px;
    anchor: center;
    location: center;
    padding: 28px;
}

mainbox {
    background-color: transparent;
    orientation: vertical;
    children: [ "inputbar", "listview" ];
    spacing: 24px;
}

inputbar {
    background-color: @bg-alt;
    text-color: @fg;
    border-radius: 20px;
    padding: 12px 20px;
    spacing: 12px;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: @fg-muted;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: @fg-muted;
    cursor: text;
}

listview {
    background-color: transparent;
    columns: 6;
    lines: 4;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    spacing: 14px;
}

element {
    background-color: transparent;
    text-color: @fg;
    orientation: vertical;
    border-radius: 16px;
    padding: 16px 8px;
    spacing: 10px;
    cursor: pointer;
}

element selected {
    background-color: @selected;
    text-color: @selected-fg;
}

element-icon {
    background-color: transparent;
    size: 56px;
    horizontal-align: 0.5;
    cursor: pointer;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: pointer;
}
